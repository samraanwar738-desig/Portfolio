/* ===========================================================
   Golden Crumb Bakery — Shared Stylesheet
   =========================================================== */

@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap');

:root{
  --crust:      #2E1B0F;   /* deep coffee-brown, headings/nav */
  --caramel:    #C87F3B;   /* warm accent, buttons, links */
  --cream:      #FBF2E6;   /* page background */
  --icing:      #E8A9A0;   /* blush pink, secondary accent */
  --butter:     #F4D58D;   /* soft gold highlight */
  --ink:        #2A1D14;   /* body text */
  --paper:      #FFFDF9;   /* card background */
  --line:       rgba(46,27,15,0.12);

  --font-display: 'Fraunces', Georgia, serif;
  --font-body: 'Manrope', -apple-system, sans-serif;

  --radius: 18px;
  --shadow: 0 10px 30px rgba(46,27,15,0.10);
  --shadow-lift: 0 18px 40px rgba(46,27,15,0.18);
}

*{ box-sizing:border-box; margin:0; padding:0; }

html{ scroll-behavior:smooth; }

body{
  font-family: var(--font-body);
  background: var(--cream);
  color: var(--ink);
  line-height:1.6;
  overflow-x:hidden;
}

img{ max-width:100%; display:block; }
a{ color:inherit; text-decoration:none; }
ul{ list-style:none; }

.container{
  width:100%;
  max-width:1180px;
  margin:0 auto;
  padding:0 24px;
}

h1,h2,h3,h4{
  font-family: var(--font-display);
  color: var(--crust);
  line-height:1.15;
  font-weight:700;
}

.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-family: var(--font-body);
  font-size:0.78rem;
  font-weight:800;
  letter-spacing:0.14em;
  text-transform:uppercase;
  color: var(--caramel);
  margin-bottom:14px;
}
.eyebrow::before{
  content:"";
  width:22px; height:2px;
  background: var(--caramel);
  display:inline-block;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:14px 30px;
  border-radius:999px;
  font-family: var(--font-body);
  font-weight:700;
  font-size:0.95rem;
  cursor:pointer;
  border:2px solid transparent;
  transition: transform .25s ease, box-shadow .25s ease, background .25s ease, color .25s ease;
}
.btn-primary{
  background: var(--crust);
  color: var(--cream);
}
.btn-primary:hover{
  background: var(--caramel);
  transform: translateY(-3px);
  box-shadow: var(--shadow-lift);
}
.btn-outline{
  background: transparent;
  border-color: var(--crust);
  color: var(--crust);
}
.btn-outline:hover{
  background: var(--crust);
  color: var(--cream);
  transform: translateY(-3px);
}
.btn-block{ width:100%; }
.btn-sm{ padding:10px 20px; font-size:0.85rem; }

/* ---------------- Header / Nav ---------------- */
.site-header{
  position: sticky;
  top:0;
  z-index:100;
  background: rgba(251,242,230,0.92);
  backdrop-filter: blur(10px);
  border-bottom:1px solid var(--line);
}
.nav{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:16px 24px;
}
.brand{
  display:flex;
  align-items:center;
  gap:10px;
  font-family: var(--font-display);
  font-weight:900;
  font-size:1.4rem;
  color: var(--crust);
}
.brand-mark{
  width:40px; height:40px;
  border-radius:50%;
  background: linear-gradient(145deg, var(--butter), var(--caramel));
  display:flex; align-items:center; justify-content:center;
  font-size:1.2rem;
  box-shadow: inset 0 -3px 6px rgba(46,27,15,0.25);
}
.nav-links{
  display:flex;
  align-items:center;
  gap:34px;
}
.nav-links a{
  font-weight:600;
  font-size:0.95rem;
  color: var(--crust);
  position:relative;
  padding:4px 0;
}
.nav-links a::after{
  content:"";
  position:absolute; left:0; bottom:-2px;
  width:0%; height:2px;
  background: var(--caramel);
  transition: width .25s ease;
}
.nav-links a:hover::after,
.nav-links a.active::after{ width:100%; }
.nav-links a.active{ color: var(--caramel); }

.nav-actions{ display:flex; align-items:center; gap:16px; }

.cart-link{
  position:relative;
  display:flex; align-items:center; justify-content:center;
  width:42px; height:42px;
  border-radius:50%;
  background: var(--paper);
  border:1px solid var(--line);
  font-size:1.1rem;
}
.cart-count{
  position:absolute;
  top:-6px; right:-6px;
  background: var(--caramel);
  color:#fff;
  font-size:0.68rem;
  font-weight:800;
  min-width:19px; height:19px;
  border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  padding:0 3px;
}

.nav-toggle{
  display:none;
  flex-direction:column;
  gap:5px;
  background:none; border:none; cursor:pointer;
}
.nav-toggle span{
  width:26px; height:2.5px;
  background: var(--crust);
  border-radius:2px;
}

/* ---------------- Hero ---------------- */
.hero{
  position:relative;
  padding:80px 0 60px;
  overflow:hidden;
}
.hero .container{
  display:grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap:50px;
  align-items:center;
}
.hero h1{
  font-size: clamp(2.6rem, 5vw, 4rem);
  margin-bottom:22px;
}
.hero h1 em{
  font-style: italic;
  color: var(--caramel);
}
.hero p.lead{
  font-size:1.08rem;
  color: rgba(42,29,20,0.78);
  max-width:480px;
  margin-bottom:32px;
}
.hero-actions{ display:flex; gap:16px; flex-wrap:wrap; margin-bottom:34px; }

.hero-stats{ display:flex; gap:36px; }
.hero-stats div strong{
  display:block;
  font-family: var(--font-display);
  font-size:1.8rem;
  color: var(--crust);
}
.hero-stats div span{
  font-size:0.8rem;
  color: rgba(42,29,20,0.6);
  text-transform:uppercase;
  letter-spacing:0.06em;
}

.hero-visual{ position:relative; }
.hero-visual img{
  border-radius: 28px;
  box-shadow: var(--shadow-lift);
  width:100%;
  height:460px;
  object-fit:cover;
}
.stamp{
  position:absolute;
  bottom:-26px; left:-26px;
  width:118px; height:118px;
  border-radius:50%;
  background: var(--butter);
  border:2px dashed var(--crust);
  display:flex; align-items:center; justify-content:center;
  text-align:center;
  font-family: var(--font-display);
  font-weight:700;
  font-size:0.78rem;
  color: var(--crust);
  line-height:1.25;
  transform: rotate(-12deg);
  animation: spin-slow 14s linear infinite;
  box-shadow: var(--shadow);
}
@keyframes spin-slow{ to{ transform: rotate(348deg); } }
@media (prefers-reduced-motion: reduce){ .stamp{ animation:none; transform: rotate(-12deg);} }

.floating-card{
  position:absolute;
  top:24px; right:-18px;
  background: var(--paper);
  padding:14px 18px;
  border-radius:16px;
  box-shadow: var(--shadow);
  display:flex; align-items:center; gap:10px;
  font-weight:700;
  font-size:0.85rem;
}
.floating-card .dot{
  width:10px; height:10px; border-radius:50%;
  background:#5FB77A;
}

/* ---------------- Wave divider (signature element) ---------------- */
.wave-divider{
  width:100%;
  height:70px;
  display:block;
}

/* ---------------- Sections ---------------- */
section{ padding:90px 0; }
.section-cream{ background: var(--cream); }
.section-crust{ background: var(--crust); color: var(--cream); }
.section-crust h2, .section-crust h3{ color: var(--butter); }
.section-header{
  max-width:620px;
  margin-bottom:52px;
}
.section-header.center{ margin-left:auto; margin-right:auto; text-align:center; }
.section-header p{ color: rgba(42,29,20,0.72); font-size:1.02rem; }
.section-crust .section-header p{ color: rgba(251,242,230,0.75); }

/* ---------------- Product / Service Cards ---------------- */
.grid{
  display:grid;
  gap:28px;
}
.grid-3{ grid-template-columns: repeat(3, 1fr); }
.grid-4{ grid-template-columns: repeat(4, 1fr); }
.grid-2{ grid-template-columns: repeat(2, 1fr); }

.card{
  background: var(--paper);
  border-radius: var(--radius);
  overflow:hidden;
  box-shadow: var(--shadow);
  transition: transform .3s ease, box-shadow .3s ease;
  display:flex;
  flex-direction:column;
}
.card:hover{ transform: translateY(-8px); box-shadow: var(--shadow-lift); }

.card-img{
  height:210px;
  overflow:hidden;
}
.card-img img{ width:100%; height:100%; object-fit:cover; transition: transform .5s ease; }
.card:hover .card-img img{ transform: scale(1.08); }

.card-body{ padding:22px 22px 24px; flex:1; display:flex; flex-direction:column; }
.card-body h3{ font-size:1.18rem; margin-bottom:8px; }
.card-body p{ color: rgba(42,29,20,0.68); font-size:0.92rem; flex:1; margin-bottom:16px; }

.card-footer{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:auto;
}
.price{
  font-family: var(--font-display);
  font-weight:700;
  font-size:1.25rem;
  color: var(--caramel);
}
.badge{
  display:inline-block;
  background: var(--icing);
  color: var(--crust);
  font-size:0.68rem;
  font-weight:800;
  letter-spacing:0.05em;
  text-transform:uppercase;
  padding:5px 10px;
  border-radius:999px;
  margin-bottom:12px;
  align-self:flex-start;
}

.add-cart-btn{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background: var(--crust);
  color:#fff;
  border:none;
  padding:10px 18px;
  border-radius:999px;
  font-weight:700;
  font-size:0.82rem;
  cursor:pointer;
  transition: background .25s ease, transform .2s ease;
}
.add-cart-btn:hover{ background: var(--caramel); transform: translateY(-2px); }
.add-cart-btn.added{ background:#5FB77A; }

/* ---------------- Services list (icon rows) ---------------- */
.service-row{
  display:flex;
  gap:20px;
  padding:26px 0;
  border-bottom:1px solid var(--line);
  align-items:flex-start;
}
.service-row:last-child{ border-bottom:none; }
.service-icon{
  width:56px; height:56px;
  border-radius:16px;
  background: var(--butter);
  display:flex; align-items:center; justify-content:center;
  font-size:1.5rem;
  flex-shrink:0;
}
.service-row h3{ font-size:1.15rem; margin-bottom:6px; }
.service-row p{ color: rgba(42,29,20,0.68); font-size:0.93rem; }

/* ---------------- Testimonials ---------------- */
.testimonial-card{
  background: var(--paper);
  border-radius: var(--radius);
  padding:30px;
  box-shadow: var(--shadow);
}
.testimonial-card .stars{ color: var(--caramel); letter-spacing:2px; margin-bottom:14px; }
.testimonial-card p{ font-style:italic; color: rgba(42,29,20,0.78); margin-bottom:18px; }
.testi-person{ display:flex; align-items:center; gap:12px; }
.testi-avatar{
  width:44px; height:44px; border-radius:50%;
  background: var(--icing);
  display:flex; align-items:center; justify-content:center;
  font-weight:800; color: var(--crust);
}
.testi-person strong{ display:block; font-size:0.92rem; }
.testi-person span{ font-size:0.78rem; color: rgba(42,29,20,0.55); }

/* ---------------- CTA band ---------------- */
.cta-band{
  background: linear-gradient(120deg, var(--crust), #4A2C17);
  color: var(--cream);
  border-radius: 28px;
  padding:60px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
  flex-wrap:wrap;
}
.cta-band h2{ color: var(--butter); margin-bottom:10px; }
.cta-band p{ color: rgba(251,242,230,0.78); }

/* ---------------- Page Hero (inner pages) ---------------- */
.page-hero{
  padding:64px 0 50px;
  text-align:center;
  background: linear-gradient(180deg, var(--butter) 0%, var(--cream) 100%);
}
.page-hero .eyebrow{ justify-content:center; }
.page-hero h1{ font-size: clamp(2.2rem,4vw,3.2rem); }
.breadcrumb{
  margin-top:14px;
  font-size:0.85rem;
  color: rgba(42,29,20,0.6);
}
.breadcrumb a{ color: var(--caramel); font-weight:700; }

/* ---------------- About page ---------------- */
.about-grid{
  display:grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap:60px;
  align-items:center;
}
.about-grid img{ border-radius: var(--radius); box-shadow: var(--shadow); height:440px; width:100%; object-fit:cover; }
.value-list{ display:grid; grid-template-columns: repeat(2,1fr); gap:20px; margin-top:20px;}
.value-item{ background: var(--paper); padding:20px; border-radius:16px; box-shadow: var(--shadow); }
.value-item h4{ font-size:1rem; margin-bottom:6px; }
.value-item p{ font-size:0.85rem; color: rgba(42,29,20,0.65); }

.team-grid{ display:grid; grid-template-columns: repeat(4,1fr); gap:26px; }
.team-card{ text-align:center; }
.team-card img{ border-radius:50%; width:130px; height:130px; object-fit:cover; margin:0 auto 16px; box-shadow: var(--shadow); }
.team-card h4{ font-size:1rem; margin-bottom:2px; }
.team-card span{ font-size:0.8rem; color: var(--caramel); font-weight:700; }

/* ---------------- Contact page ---------------- */
.contact-grid{
  display:grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap:50px;
}
.contact-info-card{
  background: var(--crust);
  color: var(--cream);
  border-radius: var(--radius);
  padding:40px 34px;
}
.contact-info-card h3{ color: var(--butter); margin-bottom:20px; }
.info-row{ display:flex; gap:14px; margin-bottom:22px; align-items:flex-start; }
.info-row .ic{ font-size:1.2rem; }
.info-row strong{ display:block; font-size:0.9rem; margin-bottom:3px;}
.info-row span{ font-size:0.85rem; color: rgba(251,242,230,0.75); }
.social-row{ display:flex; gap:12px; margin-top:30px; }
.social-row a{
  width:38px; height:38px; border-radius:50%;
  background: rgba(251,242,230,0.12);
  display:flex; align-items:center; justify-content:center;
  transition: background .25s ease;
}
.social-row a:hover{ background: var(--caramel); }

.form-card{
  background: var(--paper);
  border-radius: var(--radius);
  padding:40px;
  box-shadow: var(--shadow);
}
.form-row{ display:grid; grid-template-columns:1fr 1fr; gap:18px; }
.field{ margin-bottom:20px; }
.field label{ display:block; font-size:0.85rem; font-weight:700; margin-bottom:8px; color: var(--crust); }
.field input, .field textarea, .field select{
  width:100%;
  padding:13px 16px;
  border-radius:12px;
  border:1.5px solid var(--line);
  background: var(--cream);
  font-family: var(--font-body);
  font-size:0.92rem;
  color: var(--ink);
  transition: border-color .2s ease, box-shadow .2s ease;
}
.field input:focus, .field textarea:focus, .field select:focus{
  outline:none;
  border-color: var(--caramel);
  box-shadow: 0 0 0 4px rgba(200,127,59,0.15);
}
.field textarea{ resize:vertical; min-height:130px; }
.map-embed{ border-radius: var(--radius); overflow:hidden; margin-top:28px; box-shadow: var(--shadow); }
.map-embed iframe{ width:100%; height:260px; border:0; display:block; }

/* ---------------- Auth pages ---------------- */
.auth-wrap{
  min-height: calc(100vh - 340px);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:70px 24px;
}
.auth-card{
  background: var(--paper);
  border-radius: 24px;
  box-shadow: var(--shadow-lift);
  max-width:960px;
  width:100%;
  display:grid;
  grid-template-columns: 1fr 1fr;
  overflow:hidden;
}
.auth-visual{
  position:relative;
  background: linear-gradient(160deg, var(--crust), #4A2C17);
  padding:46px;
  color: var(--cream);
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
.auth-visual img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.28; }
.auth-visual .content{ position:relative; z-index:2; }
.auth-visual h2{ color: var(--butter); margin-bottom:12px; }
.auth-visual p{ color: rgba(251,242,230,0.8); font-size:0.92rem; }
.auth-form{ padding:46px; }
.auth-form h2{ margin-bottom:8px; }
.auth-form > p{ color: rgba(42,29,20,0.6); font-size:0.9rem; margin-bottom:28px; }
.auth-divider{
  display:flex; align-items:center; gap:14px;
  margin:22px 0;
  color: rgba(42,29,20,0.45);
  font-size:0.8rem;
}
.auth-divider::before, .auth-divider::after{
  content:""; flex:1; height:1px; background: var(--line);
}
.social-btn{
  display:flex; align-items:center; justify-content:center; gap:10px;
  width:100%;
  padding:12px;
  border-radius:12px;
  border:1.5px solid var(--line);
  background: var(--cream);
  font-weight:700;
  font-size:0.88rem;
  cursor:pointer;
  margin-bottom:12px;
  transition: border-color .2s ease, background .2s ease;
}
.social-btn:hover{ border-color: var(--caramel); background:#fff; }
.form-foot{ margin-top:22px; font-size:0.88rem; text-align:center; color: rgba(42,29,20,0.65); }
.form-foot a{ color: var(--caramel); font-weight:800; }
.checkbox-row{ display:flex; align-items:center; gap:8px; font-size:0.85rem; margin-bottom:20px; }
.checkbox-row a{ color: var(--caramel); font-weight:700; }
.forgot{ float:right; font-size:0.82rem; color: var(--caramel); font-weight:700; }

/* ---------------- Cart page ---------------- */
.cart-layout{ display:grid; grid-template-columns: 1.6fr 1fr; gap:34px; align-items:flex-start; }
.cart-table{ background: var(--paper); border-radius: var(--radius); box-shadow: var(--shadow); overflow:hidden; }
.cart-item{
  display:grid;
  grid-template-columns: 90px 1.4fr 0.8fr 0.8fr 40px;
  align-items:center;
  gap:16px;
  padding:20px 22px;
  border-bottom:1px solid var(--line);
}
.cart-item:last-child{ border-bottom:none; }
.cart-item img{ width:74px; height:74px; border-radius:12px; object-fit:cover; }
.cart-item h4{ font-size:0.98rem; margin-bottom:4px; }
.cart-item .unit{ font-size:0.8rem; color: rgba(42,29,20,0.55); }
.qty-box{ display:flex; align-items:center; border:1.5px solid var(--line); border-radius:999px; width:fit-content; }
.qty-box button{ width:30px; height:30px; border:none; background:none; font-size:1rem; cursor:pointer; color: var(--crust); font-weight:700;}
.qty-box span{ width:28px; text-align:center; font-weight:700; font-size:0.9rem; }
.remove-btn{ background:none; border:none; cursor:pointer; font-size:1.1rem; color: #C0392B; }
.cart-empty{ text-align:center; padding:70px 30px; }
.cart-empty .ic{ font-size:3rem; margin-bottom:16px; }

.summary-card{ background: var(--paper); border-radius: var(--radius); box-shadow: var(--shadow); padding:30px; }
.summary-card h3{ margin-bottom:20px; }
.summary-row{ display:flex; justify-content:space-between; font-size:0.92rem; margin-bottom:14px; color: rgba(42,29,20,0.75); }
.summary-row.total{ font-weight:800; font-size:1.1rem; color: var(--crust); border-top:1px solid var(--line); padding-top:16px; margin-top:6px; }
.promo-row{ display:flex; gap:10px; margin:20px 0; }
.promo-row input{ flex:1; padding:12px 14px; border-radius:10px; border:1.5px solid var(--line); background: var(--cream); }

/* ---------------- Footer ---------------- */
.site-footer{
  background: var(--crust);
  color: rgba(251,242,230,0.78);
  padding:70px 0 26px;
}
.footer-grid{
  display:grid;
  grid-template-columns: 1.3fr 0.8fr 0.8fr 1.1fr;
  gap:40px;
  padding-bottom:44px;
  border-bottom:1px solid rgba(251,242,230,0.12);
}
.footer-brand .brand{ color: var(--butter); margin-bottom:14px; }
.footer-brand p{ font-size:0.88rem; line-height:1.7; max-width:280px; }
.footer-col h4{ color: var(--butter); font-size:0.92rem; margin-bottom:18px; letter-spacing:0.03em; }
.footer-col ul li{ margin-bottom:11px; font-size:0.88rem; }
.footer-col ul li a:hover{ color: var(--butter); }
.footer-social{ display:flex; gap:10px; margin-top:18px; }
.footer-social a{
  width:36px; height:36px; border-radius:50%;
  background: rgba(251,242,230,0.1);
  display:flex; align-items:center; justify-content:center;
  transition: background .2s ease;
}
.footer-social a:hover{ background: var(--caramel); }
.newsletter-row{ display:flex; gap:8px; margin-top:10px; }
.newsletter-row input{
  flex:1; padding:11px 14px; border-radius:10px; border:none;
  background: rgba(251,242,230,0.1); color: var(--cream); font-size:0.85rem;
}
.newsletter-row input::placeholder{ color: rgba(251,242,230,0.5); }
.newsletter-row button{
  background: var(--caramel); border:none; color:#fff; padding:0 18px; border-radius:10px; font-weight:800; cursor:pointer;
}
.footer-bottom{
  display:flex; justify-content:space-between; align-items:center;
  padding-top:24px; font-size:0.8rem; flex-wrap:wrap; gap:10px;
}
.footer-bottom a{ margin-left:18px; }

/* ---------------- Toast ---------------- */
.toast{
  position:fixed;
  bottom:26px; right:26px;
  background: var(--crust);
  color: var(--cream);
  padding:16px 22px;
  border-radius:14px;
  box-shadow: var(--shadow-lift);
  font-weight:700;
  font-size:0.9rem;
  display:flex; align-items:center; gap:10px;
  transform: translateY(140%);
  transition: transform .35s cubic-bezier(.2,.9,.3,1.2);
  z-index:999;
}
.toast.show{ transform: translateY(0); }

/* ---------------- Responsive ---------------- */
@media (max-width: 980px){
  .grid-4{ grid-template-columns: repeat(2,1fr); }
  .grid-3{ grid-template-columns: repeat(2,1fr); }
  .about-grid, .contact-grid, .cart-layout{ grid-template-columns: 1fr; }
  .team-grid{ grid-template-columns: repeat(2,1fr); }
  .auth-card{ grid-template-columns: 1fr; }
  .auth-visual{ display:none; }
}

@media (max-width: 760px){
  .nav-links{
    position:absolute; top:100%; left:0; right:0;
    background: var(--cream);
    flex-direction:column;
    align-items:flex-start;
    padding:20px 24px 26px;
    gap:16px;
    border-bottom:1px solid var(--line);
    display:none;
  }
  .nav-links.open{ display:flex; }
  .nav-toggle{ display:flex; }
  .hero .container{ grid-template-columns:1fr; }
  .hero-visual{ order:-1; }
  .hero-visual img{ height:320px; }
  .grid-4, .grid-3, .grid-2{ grid-template-columns:1fr; }
  .cta-band{ flex-direction:column; text-align:center; padding:40px 26px; }
  .form-row{ grid-template-columns:1fr; }
  .footer-grid{ grid-template-columns: 1fr 1fr; }
  .cart-item{ grid-template-columns: 60px 1fr; row-gap:10px; }
  .cart-item .unit, .cart-item .qty-box, .cart-item .remove-btn{ grid-column: 2; }
  section{ padding:60px 0; }
  .team-grid{ grid-template-columns: 1fr 1fr; }
}
